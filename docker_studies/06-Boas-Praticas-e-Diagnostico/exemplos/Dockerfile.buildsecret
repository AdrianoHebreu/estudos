FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
# O segredo só existe durante este RUN; não fica em nenhuma camada
RUN --mount=type=secret,id=token sh -c 'echo "token com $(wc -c < /run/secrets/token) caracteres" > /tmp/prova.txt && cat /tmp/prova.txt'
RUN ls /run/secrets 2>&1 || true
